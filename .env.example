# Set in .env.local for dev, in the Vercel dashboard for production.
# Anything missing in production should fail loudly during deploy smoke.

# --- Public site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # production: https://your-domain.com

# --- Supabase (MYWEB-3) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""    # sb_publishable_... (formerly anon key)
SUPABASE_SERVICE_ROLE_KEY=""               # server-only, NEVER ship to the client
DATABASE_URL=""                            # postgres connection string for Drizzle (Session pooler)

# --- Stripe (MYWEB-8 — DEFERRED) ---
STRIPE_SECRET_KEY=""                # sk_test_... in dev
STRIPE_WEBHOOK_SECRET=""            # whsec_... — verify on every webhook
STRIPE_PRICE_PRO_MONTHLY=""         # price_...
STRIPE_PRICE_PRO_YEARLY=""          # price_...

# --- Email (MYWEB-10 — currently optional, lib/email/resend.ts no-ops without key) ---
RESEND_API_KEY=""

# --- Cache purge (internal) ---
REVALIDATE_TOKEN=""                 # 32+ random bytes; required by /api/revalidate

# --- Sentry (MYWEB-12) ---
SENTRY_DSN=""                       # server runtime only
NEXT_PUBLIC_SENTRY_DSN=""           # browser bundle (typically the same DSN)
SENTRY_ORG=""                       # build-time only, for source map upload
SENTRY_PROJECT=""                   # build-time only
SENTRY_AUTH_TOKEN=""                # build-time only — DO NOT set on the client

# --- Click logger ---
ANALYTICS_DAILY_SALT_SEED=""        # rotated daily; private
